# cp .env.example .env  — compose reads this file (the relay never writes it).
# One KEY=value per line, comments on their own lines (works with docker compose and podman-compose alike).

# REQUIRED: 8-128 chars [A-Za-z0-9_.-]; outsiders publish rtmp://public/source/<name>?token=<this>
PUBLISH_TOKEN=

# SRS image for origin and edge. 6 (default) is SRS's stable line; it writes H.265 into FLV as legacy codec id 12,
# which the relay handles (it pulls H.265 sources over SRT) but anything else reading source/ H.265 straight from
# SRS 6 needs ffmpeg >= 7.1 (OBS >= 31). 7 (develop line) emits enhanced RTMP that ffmpeg >= 6.1 / OBS >= 30 read.
SRS_IMAGE=docker.io/ossrs/srs:6

# SRT latency lives in config/srt.env (edit it or PUT :9090/srs/srt-latency?ms=N); scripts/apply-srt.sh in cron applies it.
# A token rotated through the API is kept in the relay's state volume and wins over PUBLISH_TOKEN until DELETE /state.

# delay of the public copy (seconds); per-stream overrides e.g. DELAY_MAP=stage1=5,stage2=30
DELAY_SECONDS=2
DELAY_MAP=
MAX_DELAY_SECONDS=300
MAX_BUFFER_MB=1024
MAX_STREAMS=32

# REQUIRED: the control API (CONTROL_PORT) needs "Authorization: Bearer <token>" (or ?auth=<token>); it can
# rotate the publish token and change delays, so never leave it open
CONTROL_TOKEN=

APP_IN=source
APP_OUT=live

# REQUIRED: the address the LAN-only ports (control API, SRS API, HTTP-FLV of the undelayed source, SRT ingest)
# listen on. 127.0.0.1 = this host only: SRT encoders and control-room players cannot reach SRS until you set
# your LAN/VPN address here; 0.0.0.0 only on a host that has no public interface (NAT-only home/office).
# SRT ingest carries no token, so these ports must never face the internet.
LAN_BIND=127.0.0.1
EDGE_PORT=1935
CONTROL_PORT=9090
SRS_API_PORT=1985
SRS_HTTP_PORT=8080
SRS_SRT_PORT=10080

# internal /24 for the three services (srs = .10, relay = .11); change if it clashes with your LAN.
# OWN_IP: the relay's own address as SRS sees it (defaults to the container's address; set empty to disable the
# source-address check on SRS's publish hook, e.g. with network_mode host)
SUBNET_PREFIX=172.30.77
OWN_IP=

# a stream whose consumer stalls keeps at most delay + this many seconds of buffer
MAX_BUFFER_EXTRA_SECONDS=15
# seconds the relay may spend playing out buffers on stop (keep >= longest delay + MAX_BUFFER_EXTRA_SECONDS)
STOP_GRACE_SECONDS=60
# memory limit of the relay container: ~ MAX_BUFFER_MB x 1.2 + 15 MB x 2 ffmpeg x MAX_STREAMS
RELAY_MEM_LIMIT=2200m
# how often the relay polls SRS for streams; where config/srt.env lives (./-relative or absolute; a bare name would
# become a named volume); largest live delay increase without a relay restart (keep below SRS's 5 s publish timeout)
POLL_SECONDS=3
# how the relay reads source/: auto = HTTP-FLV (the image's ffmpeg 8 reads SRS 6's H.265 FLV; an older ffmpeg makes
# H.265 on SRS 6 fall back to SRT, which adds SRS's SRT latency to the delay); flv / srt force one path
PULL=auto
CONFIG_DIR=./config
MAX_PAUSE_SECONDS=3
